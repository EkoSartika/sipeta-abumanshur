# ============================================================================
# SIPETA - Environment Variables Template (.env.example)
# Sistem Informasi Pelayanan Terpadu — Pondok Pesantren Modern Abu Manshur
#
# Project Resmi SIPETA:
# Project URL: https://jvhzrhfzkjqzlhsvvbgy.supabase.co
# Project Reference: jvhzrhfzkjqzlhsvvbgy
#
# PANDUAN PENGISIAN:
# 1. Salin berkas ini menjadi .env.local:
#    cp .env.example .env.local
# 2. Masukkan Publishable Key & Secret Key dari Supabase Dashboard.
# 3. Aplikasi mendukung format baru (sb_publishable_... / sb_secret_...)
#    serta format legacy JWT (anon / service_role).
# 4. JANGAN PERNAH menyertakan file .env.local ke dalam Git/Version Control.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Kredensial Client Publik (Terekspos ke Browser)
# Diperoleh dari: Supabase Dashboard -> Project Settings -> API
# Mendukung salah satu dari variabel berikut:
# - NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (format baru: sb_publishable_...)
# - NEXT_PUBLIC_SUPABASE_ANON_KEY (format legacy JWT / standar)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://jvhzrhfzkjqzlhsvvbgy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Atau gunakan format legacy:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ----------------------------------------------------------------------------
# 2. Kredensial Rahasia Server (SERVER-ONLY — JANGAN DIEKSPOSE KE BROWSER)
# Diperoleh dari: Supabase Dashboard -> Project Settings -> API
# Mendukung salah satu dari variabel berikut:
# - SUPABASE_SECRET_KEY (format baru: sb_secret_...)
# - SUPABASE_SERVICE_ROLE_KEY (format legacy JWT service_role)
# ----------------------------------------------------------------------------
SUPABASE_SECRET_KEY=your-secret-key-here
# Atau gunakan format legacy:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ----------------------------------------------------------------------------
# 3. Identitas Aplikasi & Pengaturan Lingkungan
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="SIPETA - Pondok Pesantren Modern Abu Manshur"
NEXT_PUBLIC_APP_ENV="development"
